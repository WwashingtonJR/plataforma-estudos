# Exemplo: configure estas variáveis no IntelliJ ou painel da hospedagem.
# Spring Boot não lê este arquivo automaticamente.
DB_URL=jdbc:postgresql://localhost:5432/plataforma_estudos
DB_USER=postgres
DB_PASSWORD=SUBSTITUA_NO_AMBIENTE
JWT_SECRET=GERE_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_BYTES
PORT=8085
# Ative apenas para um banco sem trilhas; desative depois da primeira carga.
INIT_CATALOG=false

# Opcional: configure um cliente OAuth do tipo aplicativo da Web.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:18085/login/oauth2/code/google
